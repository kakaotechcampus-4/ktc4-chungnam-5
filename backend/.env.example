# ── PostgreSQL ────────────────────────────────────────────────
# DB_URL 은 자격증명을 뺀 host:port/dbname 형태다. 사용자·비밀번호는 분리해서 받는다.
# infra/docker-compose.yml 로 띄운 로컬 DB 기준 기본값.
# 5433 인 이유: 호스트 5432 는 로컬 설치형 PostgreSQL 이 쓰는 경우가 많다.
DB_URL=localhost:5433/glp1_dev
DB_USER=glp1
DB_PASSWORD=glp1_local_dev

# SQL 로그. 로컬 디버깅할 때만 true
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── 아래는 아직 Settings 에 없다. 담당 티켓에서 추가한다 ────────
# JWT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# INTERNAL_SERVICE_TOKEN=
# AI_SERVICE_BASE_URL=
# STORAGE_TYPE=local
# S3_BUCKET=glp1-team-
# QUEUE_TYPE=local
# SQS_QUEUE_URL=
# SQS_DLQ_URL=
