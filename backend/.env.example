# ── PostgreSQL ────────────────────────────────────────────────
# DB_URL 은 자격증명을 뺀 host:port/dbname 형태다. 사용자·비밀번호는 분리해서 받는다.
# infra/docker-compose.yml 로 띄운 로컬 DB 기준 기본값.
# 5433 인 이유: 호스트 5432 는 로컬 설치형 PostgreSQL 이 쓰는 경우가 많다.
DB_URL=localhost:5433/glp1_dev
DB_USER=glp1
DB_PASSWORD=glp1_local_dev

# SQL 로그. 로컬 디버깅할 때만 true
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# local | production. production 이면 /users/* 의 X-User-Id 인증 이음새가
# 기동 자체를 막는다 (JWT 전까지 프로덕션 배포 금지 — README 참고)
APP_ENV=local

# ── 큐 ────────────────────────────────────────────────────────
# 로컬에서도 SQS 구현을 그대로 쓴다. ElasticMQ 를 컨테이너로 띄운다:
#   docker compose -f ../infra/docker-compose.queue.yml up -d
QUEUE_TYPE=sqs
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/queue/glp1-tasks
SQS_DLQ_URL=http://localhost:9324/queue/glp1-tasks-dlq
AWS_DEFAULT_REGION=ap-northeast-2

# boto3 가 서명을 만들려면 값이 있어야 한다. ElasticMQ 는 검사하지 않는다.
# 프로덕션에서는 SQS_ENDPOINT_URL 과 함께 이 둘도 비운다 — 인스턴스 역할로 붙는다.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── AI Service ────────────────────────────────────────────────
# 로컬은 ai-stub. 컨테이너 안에서는 http://ai-stub:8000 (compose 가 덮어쓴다)
AI_SERVICE_BASE_URL=http://localhost:8001
AI_TIMEOUT_SEC=45
# ai-stub 의 실패 경로를 부르는 손잡이. 평소엔 비운다. 예: ERROR_500
AI_STUB_SCENARIO=

# ── 아래는 아직 Settings 에 없다. 담당 티켓에서 추가한다 ────────
# JWT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# INTERNAL_SERVICE_TOKEN=
# STORAGE_TYPE=local
# S3_BUCKET=glp1-team-
