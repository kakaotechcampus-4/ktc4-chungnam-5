# AI Service 환경변수. 복사해서 ai/.env 로 쓴다 — ai/.env 는 gitignore 대상이다.
#   cp .env.example .env
#
# 🚨 이 repo 는 public 이다. 실제 키는 ai/.env 에만 넣는다. 이 파일에는 절대 넣지 않는다.
#

# ── LLM ───────────────────────────────────────────────────────
# Serverless API 게이트웨이. 엔드포인트 URL 이 곧 모델을 정한다.
# 실제 키·URL 은 팀 비밀 채널에서 받는다. 이 파일에는 자리표시자만 둔다.
LLM_API_KEY=
# https://mlapi.run/<UUID> 형태만 허용 (부팅 시 검증)
# 음식 인식 — Gemini Flash
LLM_VISION_URL=
# 피드백 — Claude Sonnet 5
LLM_REASONING_URL=
LLM_TIMEOUT_SEC=45
LLM_MAX_RETRIES=1

# ── BE /internal/v1 (tool 역호출) ─────────────────────────────
# ⚠️ BE 쪽은 아직 없다. tool 설계를 합의한 뒤 구현한다.
BE_INTERNAL_BASE_URL=http://localhost:8000/internal/v1
# BE 의 INTERNAL_SERVICE_TOKEN 과 같은 값
INTERNAL_SERVICE_TOKEN=
TOOL_CALL_LIMIT=3
