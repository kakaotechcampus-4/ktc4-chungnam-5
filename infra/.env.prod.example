# 운영 서버(EC2) 비밀값. 서버에서 복사해 채운다 — .env.prod 는 gitignore 대상이다.
#   cp .env.prod.example .env.prod && vi .env.prod && chmod 600 .env.prod
#
# 🚨 이 repo 는 public 이다. 실제 값은 서버의 .env.prod 에만 둔다.
#    이 파일·PR·GitHub Secrets 에 넣지 않는다.
# 🚨 AWS 액세스 키(AWS_ACCESS_KEY_ID 등)는 넣지 않는다. AWS 권한은 인스턴스 역할로만 받는다.
#
# 비밀값은 서버에서 직접 만든다: openssl rand -hex 32

# ── Caddy ─────────────────────────────────────────────────────
# 예: glp1-demo.duckdns.org (로컬 검증은 localhost)
DOMAIN=
# 앱이 X-Demo-Key 헤더로 보내는 값. APK 빌드의 --dart-define=DEMO_KEY 와 같아야 한다
DEMO_KEY=
# (선택) 키 없이 전체 API 에 접근할 팀원 공인 IP(Swagger 용). 공백으로 구분. 예: 203.0.113.7/32
# 공용 와이파이·학교망처럼 여럿이 쓰는 IP 는 넣지 않는다 — 그 망의 모두가 통과한다. 가능하면 /32.
ALLOWED_IPS=
# 스테이징(develop) 도메인. 운영 Caddy 가 이 주소로 온 요청을 스테이징 api 로 보낸다. 필수.
# 예: glp1-staging.duckdns.org (로컬 검증은 staging.localhost)
STAGING_DOMAIN=
# (K2 준비) 스테이징 앱 전용 데모 키. 운영 키와 다른 값으로 만든다 (openssl rand -hex 32).
# 아직 Caddyfile 이 쓰지 않는다. 미리 넣어 두면 키를 나눌 때 caddy 를 다시 만들지 않고 reload 로 끝난다.
STAGING_DEMO_KEY=

# ── PostgreSQL ────────────────────────────────────────────────
DB_USER=glp1
DB_PASSWORD=
DB_NAME=glp1

# ── LLM ───────────────────────────────────────────────────────
# 키·URL 은 팀 비밀 채널에서 받는다
LLM_API_KEY=
# 음식 인식 — Gemini Flash
LLM_VISION_URL=https://mlapi.run/<UUID>
# 피드백 — Claude Sonnet 5
LLM_REASONING_URL=https://mlapi.run/<UUID>
LLM_TIMEOUT_SEC=45
LLM_MAX_RETRIES=1
TOOL_CALL_LIMIT=3

# ── BE ↔ AI 내부 호출 ─────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=

# ── (선택) AI 스텁 ────────────────────────────────────────────
# 음식 인식이 머지되기 전 데모용. 실제 AI 대신 고정 더미 응답을 주는 ai-stub 을 붙인다.
# 두 줄을 같이 켠다. 위 LLM 값은 ai 컨테이너가 계속 뜨므로 그대로 채워 둔다.
# COMPOSE_PROFILES=stub
# AI_SERVICE_BASE_URL=http://ai-stub:8000

# ── (선택) 사진 저장소 S3 ─────────────────────────────────────
# 비워 두면 로컬 디스크(media 볼륨)에 저장한다. 두 줄을 같이 켠다.
# 버킷은 운영 · 스테이징이 따로다 — 스테이징의 .env.staging 에는 staging 버킷을 넣는다.
# AWS 키는 넣지 않는다. 서버 역할(ktc-ec2-ssm-role)로 권한을 받고, 리전은 서울로 고정돼 있다.
# STORAGE_TYPE=s3
# S3_BUCKET=glp1-media-prod-182844680153
